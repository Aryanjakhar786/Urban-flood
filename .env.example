# Runtime
RAINFALL_MODE=demo

# Live rainfall adapter (only after authorized access is available)
IMD_STATION_ID=
IMD_CITY_WEATHER_URL=https://mausam.imd.gov.in/api/current_wx_api.php
IMD_RAINFALL_URL=https://mausam.imd.gov.in/api/districtwise_rainfall_api.php
# REQUIRED in live mode: mm/hr OR accumulated mm
IMD_RAINFALL_UNIT=
# REQUIRED only when IMD_RAINFALL_UNIT=mm
IMD_RAINFALL_ACCUMULATION_MINUTES=0
RAIN_TIMEOUT_SECONDS=10
RAIN_CACHE_SECONDS=300

# Database
POSTGRES_DB=floodtwin
POSTGRES_USER=floodadmin
POSTGRES_PASSWORD=change-this-in-production
